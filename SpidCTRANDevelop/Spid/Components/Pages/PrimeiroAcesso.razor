@page "/primeiro-acesso"
@layout LoginLayout
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Authorization
@using Spid.Data
@inject AppDbContext Db
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject UserSession UserSession
@inject NavigationManager Nav
<PageTitle>Primeiro Acesso — SPID</PageTitle>

<div class="login-container">
    <div class="login-card">
        <div class="row w-100 align-items-center">
            <!-- Coluna Esquerda: Logo e Textos -->
            <div class="col-md-5 text-center mb-4 mb-md-0 border-md-end pe-md-4 d-flex flex-column justify-content-center align-items-center">
                <img src="spid_web.png" alt="SPID Logo" class="mb-3" style="max-width: 160px; width: 100%;" />
                <h2 class="mb-2 text-center" style="font-size: 1.75rem; font-weight: 700; color: #1a1a2e; line-height: 1.2;">
                    SPID<br />Primeiro Acesso
                </h2>
                <p class="text-center" style="color: #6c757d; font-size: 1.05rem; margin-bottom: 0;">Preencha o formulário para continuar</p>
            </div>

            <!-- Coluna Direita: Formulário -->
            <div class="col-md-7 ps-md-4">

        @if (!string.IsNullOrEmpty(erro))
        {
            <div class="alert alert-danger" role="alert">
                @erro
            </div>
        }

        @if (!string.IsNullOrEmpty(sucesso))
        {
            <div class="alert alert-success" role="alert">
                @sucesso
            </div>
        }

        @if (usuario is not null)
        {
            <EditForm Model="this" OnValidSubmit="Salvar">
                <div class="row mb-3">
                    <div class="col-8">
                        <label class="form-label">Nome</label>
                        <input type="text" class="form-control" value="@usuario.Nome" disabled />
                    </div>
                    <div class="col-4">
                        <label class="form-label">Ponto</label>
                        <input type="text" class="form-control" value="@usuario.Ponto" disabled />
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-6">
                        <label class="form-label">CPF</label>
                        <input type="text" @bind="cpf" class="form-control" placeholder="000.000.000-00" />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Centro de Custo</label>
                        <div class="form-control bg-light" style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@(nomeCentroCusto ?? "Não informado")</div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">E-mail (Conta Google/Gmail)</label>
                    <input type="email" @bind="email" class="form-control" placeholder="Ex: joao@gmail.com" />
                    <div class="form-text">É necessário informar uma conta de e-mail do Google (Gmail).</div>
                </div>

                <hr class="my-3" />

                <div class="mb-3">
                    <label class="form-label">Nova Senha</label>
                    <div class="input-group">
                        <input type="@(mostrarNovaSenha ? "text" : "password")" @bind="novaSenha" class="form-control" placeholder="Digite sua nova senha" />
                        <button class="btn btn-outline-secondary d-flex align-items-center justify-content-center" type="button" @onclick="() => mostrarNovaSenha = !mostrarNovaSenha">
                            @if (mostrarNovaSenha)
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M13.359 11.238C15.06 9.72 16 8 16 8s-3-5.5-8-5.5a7 7 0 0 0-2.79.588l.77.771A6 6 0 0 1 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755q-.247.248-.517.486z"/>
                                    <path d="M11.297 9.176a3.5 3.5 0 0 0-4.474-4.474l.823.823a2.5 2.5 0 0 1 2.829 2.829zm-2.943 1.299.822.822a3.5 3.5 0 0 1-4.474-4.474l.823.823a2.5 2.5 0 0 0 2.829 2.829"/>
                                    <path d="M3.35 5.47q-.27.24-.518.487A13 13 0 0 0 1.172 8l.195.288c.335.48.83 1.12 1.465 1.755C4.121 11.332 5.881 12.5 8 12.5c.716 0 1.39-.133 2.02-.36l.77.772A7 7 0 0 1 8 13.5C3 13.5 0 8 0 8s.939-1.721 2.641-3.238l.708.709zm10.296 8.884-12-12 .708-.708 12 12z"/>
                                </svg>
                            }
                            else
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/>
                                    <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/>
                                </svg>
                            }
                        </button>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Confirme sua Senha</label>
                    <div class="input-group">
                        <input type="@(mostrarConfirmaSenha ? "text" : "password")" @bind="confirmaSenha" class="form-control" placeholder="Confirme sua nova senha" />
                        <button class="btn btn-outline-secondary d-flex align-items-center justify-content-center" type="button" @onclick="() => mostrarConfirmaSenha = !mostrarConfirmaSenha">
                            @if (mostrarConfirmaSenha)
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M13.359 11.238C15.06 9.72 16 8 16 8s-3-5.5-8-5.5a7 7 0 0 0-2.79.588l.77.771A6 6 0 0 1 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755q-.247.248-.517.486z"/>
                                    <path d="M11.297 9.176a3.5 3.5 0 0 0-4.474-4.474l.823.823a2.5 2.5 0 0 1 2.829 2.829zm-2.943 1.299.822.822a3.5 3.5 0 0 1-4.474-4.474l.823.823a2.5 2.5 0 0 0 2.829 2.829"/>
                                    <path d="M3.35 5.47q-.27.24-.518.487A13 13 0 0 0 1.172 8l.195.288c.335.48.83 1.12 1.465 1.755C4.121 11.332 5.881 12.5 8 12.5c.716 0 1.39-.133 2.02-.36l.77.772A7 7 0 0 1 8 13.5C3 13.5 0 8 0 8s.939-1.721 2.641-3.238l.708.709zm10.296 8.884-12-12 .708-.708 12 12z"/>
                                </svg>
                            }
                            else
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/>
                                    <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/>
                                </svg>
                            }
                        </button>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 mb-3" disabled="@salvando">
                    @if (salvando)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    }
                    Salvar e Entrar
                </button>

                <div class="text-center">
                    <a href="/logout-handler" class="btn btn-danger-custom text-decoration-none" style="padding: 0.4rem 1.5rem; font-size: 0.85em; font-weight: normal;">Cancelar</a>
                </div>
            </EditForm>
        }
            </div>
        </div>
    </div>
</div>

@code {
    private Usuario? usuario;
    private string? nomeCentroCusto;

    private string email = "";
    private string cpf = "";
    private string novaSenha = "";
    private string confirmaSenha = "";
    private bool mostrarNovaSenha = false;
    private bool mostrarConfirmaSenha = false;

    private string? erro;
    private string? sucesso;
    private bool salvando;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true && !UserSession.IsAuthenticated)
        {
            await using var dbCtx = await DbFactory.CreateDbContextAsync();
            await UserSession.TryRestoreFromClaimsAsync(user, dbCtx);
        }

        if (!UserSession.IsAuthenticated)
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }

        usuario = UserSession.UsuarioLogado;

        if (usuario is null)
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }

        // Se já completou o primeiro acesso, redireciona para a home
        if (usuario.ContadorAcessos > 0)
        {
            Nav.NavigateTo("/");
            return;
        }

        // Carrega o nome do centro de custo
        if (usuario!.CentroCustoId.HasValue == true && usuario!.CentroCustoId > 0)
        {
            var centroCusto = await Db.CentrosCusto.FindAsync(usuario!.CentroCustoId.Value);
            nomeCentroCusto = centroCusto?.Nome;
        }

        // Preenche campos editáveis com dados existentes
        email = usuario!.Email ?? "";
        cpf = usuario!.Cpf ?? "";
    }

    private async Task Salvar()
    {
        erro = null;
        sucesso = null;
        salvando = true;

        try
        {
            if (string.IsNullOrWhiteSpace(email))
            {
                erro = "O e-mail é obrigatório.";
                return;
            }

            if (!email.Trim().EndsWith("@gmail.com", StringComparison.OrdinalIgnoreCase))
            {
                erro = "É necessário utilizar uma conta de e-mail do Google (@gmail.com).";
                return;
            }

            if (string.IsNullOrWhiteSpace(novaSenha))
            {
                erro = "A nova senha é obrigatória.";
                return;
            }

            if (novaSenha.Length < 8)
            {
                erro = "A senha deve ter no mínimo 8 caracteres.";
                return;
            }

            if (novaSenha != confirmaSenha)
            {
                erro = "As senhas não conferem.";
                return;
            }

            // Atualiza a senha e marca primeiro acesso como concluído
            var usuarioBd = await Db.Usuarios.FindAsync(usuario!.Id);
            if (usuarioBd is null)
            {
                erro = "Usuário não encontrado.";
                return;
            }

            usuarioBd.Email = email;
            usuarioBd.Cpf = string.IsNullOrWhiteSpace(cpf) ? null : cpf;
            usuarioBd.SenhaHash = UserSession.HashSenha(usuarioBd, novaSenha);
            usuarioBd.ContadorAcessos = 1;
            await Db.SaveChangesAsync();

            // Atualiza a referência na sessão
            usuario.Email = usuarioBd.Email;
            usuario.Cpf = usuarioBd.Cpf;
            usuario.SenhaHash = usuarioBd.SenhaHash;
            usuario.ContadorAcessos = 1;

            Nav.NavigateTo("/");
        }
        catch (Exception ex)
        {
            erro = $"Erro ao salvar: {ex.Message}";
        }
        finally
        {
            salvando = false;
        }
    }
}

@page "/usuarios"
@namespace Spid.Components.Pages
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Web
@using Spid.Data
@using Spid.Services
@using Spid.Components.Shared
@inject AppDbContext Db
@inject UserSession UserSession
@inject NavigationManager Nav

<PageTitle>Gerenciar Usuários — SPID</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3>
        <Icon Name="users-gear" Size="24" Class="page-header-icon" /> Gerenciar Usuários
    </h3>
    <a href="/usuarios/novo" class="btn btn-primary">
        <Icon Name="user-plus" Size="14" style="--icon-primary: rgba(255,255,255,0.9); --icon-secondary: rgba(255,255,255,0.6); --icon-secondary-opacity: 1;" /> Novo Usuário
    </a>
</div>

@if (!isAdmin)
{
    <div class="alert alert-warning">Você não tem permissão para acessar esta página.</div>
}
else if (todosUsuarios is null)
{
    <p class="text-muted">Carregando...</p>
}
else if (todosUsuarios.Count == 0)
{
    <div class="alert alert-info">Nenhum usuário cadastrado.</div>
}
else
{
    <!-- Filtros -->
    <div class="card shadow-sm mb-4" style="border: 2px solid rgba(111, 66, 193, 0.4);">
        <div class="card-body d-flex align-items-center gap-3 flex-wrap">
            <div class="d-flex align-items-center gap-3">
                <label class="form-label mb-0 fw-bold text-nowrap">Filtrar por Perfil:</label>
                <select class="form-select text-center" style="height: 34px; border-radius: 8px; width: 180px; padding-top: 0; padding-bottom: 0;" 
                        @bind="perfilSelecionado" @bind:after="OnPerfilChanged">
                    <option value="Todos">Todos os Perfis</option>
                    <option value="Admin">Admins</option>
                    <option value="Gestores">Gestores</option>
                    <option value="Gestores Centrais">Gestores Centrais</option>
                </select>
                
                <select class="form-select text-center" style="height: 34px; border-radius: 8px; width: 160px; padding-top: 0; padding-bottom: 0;" 
                        @bind="subtipoSelecionado" @bind:after="AplicarFiltrosEOrdenacao"
                        disabled="@(perfilSelecionado == "Todos" || perfilSelecionado == "Admin")">
                    <option value="Todos">Todos</option>
                    @if (perfilSelecionado == "Gestores")
                    {
                        <option value="Titular">Titular(es)</option>
                        <option value="Substituto">Substituto(s)</option>
                    }
                    else if (perfilSelecionado == "Gestores Centrais")
                    {
                        <option value="Padrão">Padrão</option>
                        <option value="Ateste">Ateste</option>
                    }
                </select>

                <div class="form-check form-switch ms-2 mt-1">
                    <input class="form-check-input" type="checkbox" role="switch" id="checkInativos" @bind="incluirInativos" @bind:after="AplicarFiltrosEOrdenacao">
                    <label class="form-check-label text-nowrap user-select-none" for="checkInativos" style="cursor: pointer;">
                        Incluir Inativos
                    </label>
                </div>

                @if (UserSession.UsuarioLogado?.Perfil == "Admin")
                {
                    <div class="form-check form-switch ms-2 mt-1">
                        <input class="form-check-input" type="checkbox" role="switch" id="checkApenasTeste" @bind="apenasDeTeste" @bind:after="AplicarFiltrosEOrdenacao">
                        <label class="form-check-label text-nowrap user-select-none" for="checkApenasTeste" style="cursor: pointer;">
                            Apenas de Teste
                        </label>
                    </div>
                }
            </div>
            
            <div class="ms-auto">
                <span class="badge bg-light text-dark border small py-2 px-3">
                    Exibindo <strong>@(usuarios?.Count ?? 0)</strong> de <strong>@(todosUsuarios?.Count ?? 0)</strong> usuários
                </span>
            </div>
        </div>
    </div>

    @if (usuarios is null || usuarios.Count == 0)
    {
        <div class="alert alert-info">Nenhum usuário encontrado com os filtros selecionados.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-purple">
                    <tr class="align-middle">
                        <th class="text-center">Perfil</th>
                        <th class="text-center" role="button" style="cursor: pointer; user-select: none;" @onclick="AlternarOrdemNome">
                            Nome @(ordenarNomeAsc ? "▲" : "▼")
                        </th>
                        <th class="text-center">Ponto</th>
                        <th class="text-center">E-mail</th>
                        <th class="text-center">Centro de Custo</th>
                        <th class="text-center">Status</th>
                        <th class="text-center">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in usuarios)
                    {
                        <tr class="@(u.Ativo ? "" : "table-secondary")">
                            <td class="text-center">
                                @if (u.Perfil == "Gestor Central Ateste")
                                {
                                    <span class="badge text-white" style="background-color: #fd7e14;">@u.Perfil</span>
                                }
                                else
                                {
                                    <span class="badge text-white @(u.Perfil == "Admin" ? "bg-danger" : u.Perfil == "Gestor Central Padrão" ? "bg-warning" : u.Perfil == "Gestor Substituto" ? "bg-info" : "bg-primary")">
                                        @u.Perfil
                                    </span>
                                }
                            </td>
                            <td class="text-center">
                                @u.Nome
                                @if (u.IsTeste)
                                {
                                    <span class="badge text-white ms-2" style="background-color: #6f42c1;">TESTE</span>
                                }
                            </td>
                            <td class="text-center"><code>@u.Ponto</code></td>
                            <td class="text-center">@u.Email</td>
                            <td class="text-center">@(u.CentroCusto?.Nome ?? "—")</td>
                            <td class="text-center">
                                <span class="badge @(u.Ativo ? "bg-success" : "bg-secondary")">
                                    @(u.Ativo ? "Ativo" : "Inativo")
                                </span>
                            </td>
                            <td class="text-center">
                                <div class="user-action-group">
                                    @if (PodeEditar(u))
                                    {
                                        <a href="/usuarios/editar/@u.Id" class="btn btn-sm btn-user-action btn-user-edit"
                                           title="Editar usuário">
                                            <Icon Name="user-pen" Size="15" Class="icon-duotone action-icon" style="--icon-primary: rgba(255,255,255,0.9); --icon-secondary: rgba(255,255,255,0.6); --icon-secondary-opacity: 1;" /> Editar
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Sem permissão</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private List<Usuario>? todosUsuarios;
    private List<Usuario>? usuarios;
    private bool isAdmin;
    private string perfilSelecionado = "Todos";
    private string subtipoSelecionado = "Todos";
    private bool ordenarNomeAsc = true;
    private bool incluirInativos = false;
    private bool apenasDeTeste = false;

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsAuthenticated)
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }

        var perfilLogado = UserSession.UsuarioLogado!.Perfil;
        isAdmin = perfilLogado == "Admin" || perfilLogado.StartsWith("Gestor Central");
        if (!isAdmin) return;

        // Pré-selecionar filtro
        if (perfilLogado == "Admin")
        {
            perfilSelecionado = "Admin";
        }
        else if (perfilLogado.StartsWith("Gestor Central "))
        {
            perfilSelecionado = "Gestores Centrais";
            subtipoSelecionado = perfilLogado.Replace("Gestor Central ", "");
        }
        else if (perfilLogado.StartsWith("Gestor "))
        {
            perfilSelecionado = "Gestores";
            subtipoSelecionado = perfilLogado.Replace("Gestor ", "");
        }

        await CarregarUsuarios();
    }

    private async Task CarregarUsuarios()
    {
        var usuariosQuery = await Db.Usuarios
            .Include(u => u.CentroCusto)
            .ToListAsync();

        var perfilLogado = UserSession.UsuarioLogado!.Perfil;
        if (perfilLogado != "Admin")
        {
            usuariosQuery = usuariosQuery.Where(u => !u.IsTeste).ToList();
        }
        
        todosUsuarios = usuariosQuery;

        AplicarFiltrosEOrdenacao();
    }

    private bool PodeEditar(Usuario alvo)
    {
        var perfilLogado = UserSession.UsuarioLogado!.Perfil;
        var logadoId = UserSession.UsuarioLogado!.Id;
        
        if (perfilLogado == "Admin" || alvo.Id == logadoId) return true;
        
        if (perfilLogado == "Gestor Central Ateste")
        {
            return alvo.Perfil != "Admin" && alvo.Perfil != "Gestor Central Ateste";
        }
        
        if (perfilLogado == "Gestor Central Padrão")
        {
            return alvo.Perfil == "Gestor Titular" || alvo.Perfil == "Gestor Substituto" || alvo.Perfil == "Gestor Sem Setor";
        }
        
        return false;
    }

    private int ObterPesoPerfil(string perfil) => perfil switch
    {
        "Admin" => 1,
        "Gestor Central Ateste" => 2,
        "Gestor Central Padrão" => 3,
        "Gestor Titular" => 4,
        "Gestor Substituto" => 5,
        "Colaborador" => 6,
        _ => 99
    };

    private void AplicarFiltrosEOrdenacao()
    {
        if (todosUsuarios is null) return;

        var query = todosUsuarios.AsEnumerable();

        if (!incluirInativos)
        {
            query = query.Where(u => u.Ativo);
        }

        if (apenasDeTeste)
        {
            query = query.Where(u => u.IsTeste);
        }
        else
        {
            query = query.Where(u => !u.IsTeste);
        }

        // 1. Filtrar por Perfil
        if (perfilSelecionado != "Todos")
        {
            if (perfilSelecionado == "Gestores")
            {
                if (subtipoSelecionado == "Todos")
                    query = query.Where(u => u.Perfil == "Gestor Titular" || u.Perfil == "Gestor Substituto" || u.Perfil == "Gestor Sem Setor");
                else
                    query = query.Where(u => u.Perfil == $"Gestor {subtipoSelecionado}");
            }
            else if (perfilSelecionado == "Gestores Centrais")
            {
                if (subtipoSelecionado == "Todos")
                    query = query.Where(u => u.Perfil == "Gestor Central Padrão" || u.Perfil == "Gestor Central Ateste");
                else
                    query = query.Where(u => u.Perfil == $"Gestor Central {subtipoSelecionado}");
            }
            else
            {
                query = query.Where(u => u.Perfil == perfilSelecionado);
            }
        }

        // 2. Ordenar por Perfil (Hierarquia) e depois por Nome
        query = ordenarNomeAsc 
            ? query.OrderBy(u => ObterPesoPerfil(u.Perfil)).ThenBy(u => u.Nome, StringComparer.CurrentCultureIgnoreCase) 
            : query.OrderByDescending(u => ObterPesoPerfil(u.Perfil)).ThenByDescending(u => u.Nome, StringComparer.CurrentCultureIgnoreCase);

        usuarios = query.ToList();
    }

    private void AlternarOrdemNome()
    {
        ordenarNomeAsc = !ordenarNomeAsc;
        AplicarFiltrosEOrdenacao();
    }

    private void OnPerfilChanged()
    {
        subtipoSelecionado = "Todos";
        AplicarFiltrosEOrdenacao();
    }
}
